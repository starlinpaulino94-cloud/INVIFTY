# =============================================================================
# INVIFTY WEB — variables de entorno de ejemplo
# =============================================================================
# Copia este archivo a `.env.local` y ajusta los valores.
# `.env.local` está en .gitignore y nunca debe subirse al repositorio.
#
# ⚠️ SEGURIDAD: todas las variables con prefijo VITE_ se incrustan en el
# JavaScript público y son visibles para cualquier visitante. NUNCA pongas aquí
# claves de API, tokens ni secretos. Si Studio necesita autenticación, debe
# resolverse en un endpoint de servidor.
#
# Todas las variables son opcionales: sin ningún .env la web funciona con los
# valores por defecto definidos en src/config/env.ts.
# =============================================================================

# URL pública del sitio, sin barra final.
# Se usa como base para canonical, Open Graph y enlaces absolutos.
VITE_SITE_URL=https://invifty.com

# Número de WhatsApp en formato internacional, SOLO DÍGITOS.
# Incluye el código de país y no lleva +, espacios ni guiones.
# Ejemplo para República Dominicana: 1 + 809 + 2693214
VITE_WHATSAPP_NUMBER=18092693214

# ID de medición de Google Analytics 4, formato "G-XXXXXXXXXX".
# Déjalo VACÍO para desactivar GA4 por completo: sin ID no se carga su script
# ni se instala ninguna cookie. Hoy está vacío a propósito.
VITE_GA_MEASUREMENT_ID=

# Analítica de Vercel (sin cookies). Activada por defecto; pon "false" para
# apagarla. Requiere activar "Web Analytics" en el panel del proyecto en Vercel.
# Las visitas de página se miden en el plan gratuito; los eventos
# personalizados requieren plan Pro.
VITE_ENABLE_VERCEL_ANALYTICS=true

# Token de verificación de Google Search Console.
# Es SÓLO el valor de `content=` de la etiqueta que da Google, no la etiqueta
# entera. No es un secreto: sirve para demostrar que controlas el dominio.
# Al ponerlo, la etiqueta se inserta en las 21 rutas del sitio.
# Déjalo vacío si vas a verificar por registro DNS en vez de por etiqueta.
VITE_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Integración futura con Invifty Studio
# Ver docs/integracion-futura-studio.md
# -----------------------------------------------------------------------------

# URL base de la API pública de Studio (sin barra final).
# Déjalo vacío mientras Studio no exponga los endpoints públicos.
VITE_STUDIO_API_URL=

# Feature flag: enviar los leads del formulario a Studio en vez de a WhatsApp.
# Sólo tiene efecto si VITE_STUDIO_API_URL también está configurado.
# Mientras esté en false, el formulario usa WhatsApp como canal de envío.
VITE_ENABLE_STUDIO_LEADS=false
